# Set separate non-owner LOGIN credentials; do not use migration credentials in API.
API_DATABASE_URL=postgresql://API_LOGIN:REPLACE@127.0.0.1:55432/postgres
AUTH_DATABASE_URL=postgresql://AUTH_LOGIN:REPLACE@127.0.0.1:55432/postgres
ADMIN_DATABASE_URL=postgresql://ADMIN_LOGIN:REPLACE@127.0.0.1:55432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_LOGIN:REPLACE@127.0.0.1:55432/postgres
JWT_PRIVATE_KEY_FILE=work/keys/private.pem
JWT_PUBLIC_KEY_FILE=work/keys/public.pem
APP_ORIGIN=https://localhost
COOKIE_SECURE=1

S3_ENDPOINT=http://127.0.0.1:18333
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
S3_BUCKET=visual-private
S3_REGION=us-east-1

# Compose infrastructure uses a separate generated private profile.
# Run: python scripts/dev.py up --profile-dir .local/compose
# These deliberately empty values are not production passwords.
PG_BOOTSTRAP_USER=
PG_BOOTSTRAP_PASSWORD=
MQ_BOOTSTRAP_USER=
MQ_BOOTSTRAP_PASSWORD=
VISUAL_OWNER=
VISUAL_WORKSPACE=
S3_CONFIG_FILE=
